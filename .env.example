# Google Gemini API Key for server-side Neural Assistant (/api/chat)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Contact Email Delivery Service (Optional: Resend or Formspree)
# If left blank, /api/contact falls back to local logging and client toast confirmation
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=rdpkumar2308@gmail.com
FORMSPREE_ENDPOINT=

# Optional: GitHub Personal Access Token to avoid unauthenticated API rate limits on /api/github
GITHUB_TOKEN=

# Base URL for canonical SEO and OpenGraph generation
NEXT_PUBLIC_SITE_URL=https://pavan-portfolio-iota-ruby.vercel.app
