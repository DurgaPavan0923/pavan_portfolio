# ==============================================================================
# Rajana Durga Pavan Kumar — AI & ML Portfolio Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# 1. Canonical Site URL (Canonical links, OpenGraph, dynamic sitemap & robots.txt)
NEXT_PUBLIC_SITE_URL=https://pavan-portfolio-gamma-six.vercel.app

# 2. Google Gemini API (Server-side Neural Assistant at /api/chat)
# Recommended model: gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. GitHub GraphQL API Token (Server-side Open Source telemetry at /api/github)
# Generate a Personal Access Token with read-only scope for user DurgaPavan0923 at:
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# 4. Contact Delivery Pipeline (/api/contact)
# Primary Email Dispatch: Resend (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_TO_EMAIL=rdpkumar2308@gmail.com
# Note: Use 'onboarding@resend.dev' until your custom domain is verified in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# Optional: Set to 'true' to send an automated confirmation email back to the inquiry sender
SEND_AUTOREPLY=false

# 5. Secondary Contact Fallback: Gmail SMTP via Nodemailer
# If Resend is unconfigured or blocked, the API automatically falls back to Gmail SMTP
GMAIL_USER=your_gmail_username@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_character_app_password

# 6. Optional Rate Limiting: Upstash Redis
# If omitted, /api/contact and /api/chat fall back to in-memory sliding window rate limiters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
